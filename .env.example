# Lokale Laufzeitkonfiguration für GeoFACT (siehe README.md und docs/web_demo.md).
# Nach .env kopieren und Werte anpassen. .env ist gitignored: niemals Secrets oder DSN einchecken.
# Eine leere Variable bedeutet: es gilt der genannte Standard.
# Das Web-Backend liest .env beim Start; die Kommandozeile (geofact ...) liest nur echte
# Umgebungsvariablen.

# =====================================================================
# 1. Daten beziehen (Kern)
# =====================================================================

# OSM-Quelle: overpass (Standard) oder postgis
GEOFACT_OSM_BACKEND=overpass
# Overpass-Endpunkt; Standard https://overpass-api.de/api/interpreter
GEOFACT_OVERPASS_URL=
# PostGIS mit OSM-Import, nur für GEOFACT_OSM_BACKEND=postgis:
# postgresql://user:passwort@host:5432/dbname
GEOFACT_PG_DSN=
# Timeout für PostGIS-Abfragen in Sekunden; Standard 120
GEOFACT_PG_QUERY_TIMEOUT_S=120

# Ablage der Snapshots (OSM, Region, WFS, ...); Standard .geofact/snapshots
GEOFACT_SNAPSHOT_DIR=

# WFS/CKAN: HTTP-Timeout in Sekunden (Standard 60) und Größenlimit in MB (Standard 200)
GEOFACT_OPENDATA_TIMEOUT_S=
GEOFACT_OPENDATA_MAX_MB=

# =====================================================================
# 2. Plugins
# =====================================================================

# Plugin-Ordner, getrennt mit ; (Windows) bzw. : (sonst). Das Beispiel
# sachsen_netz_resilienz braucht das mitgelieferte Fach-Plugin in examples/plugins.
# Ist die Variable leer, lädt das Web-Backend diesen Ordner von selbst; die
# Kommandozeile lädt dann keine Plugins.
GEOFACT_PLUGIN_PATH=examples/plugins

# =====================================================================
# 3. Web-Backend (uv run --extra web geofact-api)
# =====================================================================

# Adresse des Servers
GEOFACT_WEB_HOST=127.0.0.1
GEOFACT_WEB_PORT=8000
# Erlaubte Frontend-Origins, kommagetrennt
GEOFACT_WEB_CORS=http://localhost:3000,http://127.0.0.1:3000

# Ablageorte; Standard .geofact_web bzw. .geofact_web/uploads
GEOFACT_WEB_DATA_DIR=
GEOFACT_WEB_UPLOADS_DIR=
# Lokale Raster für den Quellenkatalog; Standard examples/data
GEOFACT_COPERNICUS_DIR=
# Maximale Upload-Größe in Bytes; Standard 200 MiB
GEOFACT_WEB_MAX_UPLOAD=209715200

# Alter in Stunden, ab dem ein fremdes Laufverzeichnis unter .geofact_web/runs beim
# Start entfernt wird; Standard 6, Zahl > 0
GEOFACT_WEB_RUN_DIR_MAX_AGE_HOURS=
# Auto-Reload beim Entwickeln (1 = an); Standard aus. Jeder Neustart verwirft die
# Läufe im Arbeitsspeicher. Ein Backend je Datenverzeichnis und Port.
GEOFACT_WEB_RELOAD=

# =====================================================================
# 4. Sprachmodell (optional; ohne Schlüssel ist nur "Szenario generieren" aus)
# =====================================================================

# Zugang (OpenAI-kompatibel, Standard OpenRouter). Ein Schlüssel genügt.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Modell und Anbieter
GEOFACT_LLM_MODEL=anthropic/claude-3.5-sonnet
# Anbieterbindung bei OpenRouter (kommagetrennt, in dieser Reihenfolge, ohne
# Ausweichen); leer = der Router wählt je Anfrage
GEOFACT_LLM_PROVIDER=
# Weitere im Einstellungsdialog wählbare Modelle (kommagetrennt), je "modell"
# oder "modell@anbieter1+anbieter2"; leer = keine Auswahl
GEOFACT_LLM_CHOICES=

# Grenzen einer Anfrage
# Reasoning-Ausgabe mitstreamen (nur bei Modellen, die sie liefern)
GEOFACT_LLM_REASONING=true
# Obergrenze der Antwortlänge in Tokens
GEOFACT_LLM_MAX_TOKENS=8000
# Gesamtfrist je Anfrage in Sekunden
GEOFACT_LLM_DEADLINE_S=300

# Prüfung der erzeugten Konfiguration
# Reparaturrunden je Erzeugung (0 = keine)
GEOFACT_LLM_REPAIR_ROUNDS=3
# Probelauf auf den echten Daten und seine Frist in Sekunden
GEOFACT_LLM_TRIAL_RUN=true
GEOFACT_LLM_TRIAL_RUN_S=60

# =====================================================================
# 5. Anmeldung und Läufe (optional; ohne GEOFACT_WEB_USERS ist die Demo offen)
# =====================================================================

# Nutzer als name:salt.hash, kommagetrennt; erzeugen mit
# uv run python scripts/add_web_user.py <name>
GEOFACT_WEB_USERS=
# Signaturschlüssel der Anmeldung, z. B. python -c "import secrets; print(secrets.token_hex(32))"
GEOFACT_WEB_SECRET_KEY=
# Gültigkeit einer Anmeldung in Sekunden; Standard 43200
GEOFACT_WEB_TOKEN_TTL_S=
# Gleichzeitige Läufe je Nutzer (Standard 2) und aufbewahrte fertige Läufe (Standard 20)
GEOFACT_WEB_MAX_CONCURRENT_RUNS_PER_USER=
GEOFACT_WEB_MAX_RETAINED_RUNS=

# Weitere Variablen (Nominatim- und DALICC-Adresse, WFS-Seitengröße, Katalogdateien):
# docs/web_demo.md, Abschnitt Umgebungsvariablen.
