# Einstellungen des Serverpakets (docker-compose.server.yml, docs/server_installation.md).
# Als ".env" neben docker-compose.server.yml speichern; alles ist optional.

# --- Version ------------------------------------------------------------------
# Tag der Images (z. B. v1.0-abgabe). Werkzeug aktualisieren: Wert ändern, dann
#   docker compose -f docker-compose.server.yml pull && docker compose -f docker-compose.server.yml up -d
# GEOFACT_VERSION=latest
# GEOFACT_IMAGE=ghcr.io/erichsdb/geofact-project

# --- Erreichbarkeit -----------------------------------------------------------
# Leer: http auf Port 80 aller Schnittstellen, also auch im LAN (http://<IP des Rechners>/).
# Ein Domainname (DNS zeigt auf diesen Rechner, Ports 80 und 443 offen): https mit
# automatischem Zertifikat von Let's Encrypt.
# GEOFACT_SITE_ADDRESS=geofact.example.org
# Nur auf diesem Rechner erreichbar:
# GEOFACT_BIND=127.0.0.1
# Andere Ports, falls 80/443 belegt sind (mit Domainname müssen es 80/443 sein):
# GEOFACT_HTTP_PORT=8080
# GEOFACT_HTTPS_PORT=8443

# --- Anmeldung (empfohlen, sobald die Adresse von außen erreichbar ist) ---------
# name:hash-Paare, kommagetrennt; Hash erzeugen mit
#   docker compose -f docker-compose.server.yml run --rm --no-deps backend python scripts/add_web_user.py <name>
# Leer: keine Anmeldung.
# GEOFACT_WEB_USERS=
# Signaturschlüssel der Tokens, z. B. aus: python -c "import secrets; print(secrets.token_hex(32))"
# GEOFACT_WEB_SECRET_KEY=

# --- Datenbank ------------------------------------------------------------------
# Passwort der internen Datenbank (nur im Docker-Netz erreichbar). Vor dem ersten Start
# setzen - später ändern heißt: Volume pg_data neu anlegen.
# GEOFACT_PG_PASSWORD=geofact
# GEOFACT_PG_SHARED_BUFFERS=2GB
# GEOFACT_PG_MAINTENANCE_WORK_MEM=2GB
# GEOFACT_PG_QUERY_TIMEOUT_S=300

# --- OSM-Import -------------------------------------------------------------------
# Extrakt (Standard Deutschland); für einen schnellen Test z. B. Sachsen:
# GEOFACT_OSM_PBF_URL=https://download.geofabrik.de/europe/germany/sachsen-latest.osm.pbf
# MD5-Datei dazu (Standard <URL>.md5; "none" schaltet die Prüfung ab):
# GEOFACT_OSM_PBF_MD5_URL=
# Arbeitsspeicher von osm2pgsql in MB und Anzahl Prozesse:
# GEOFACT_OSM_CACHE_MB=4000
# GEOFACT_OSM_PROCESSES=

# --- Beispieldaten ---------------------------------------------------------------
# Globales GHS-POP-Raster (5,3 GB; Berlin- und Europa-Beispiel). "none" lässt es aus,
# dann bleibt der auf Sachsen zugeschnittene Ausschnitt aus dem Image.
# GEOFACT_GHS_POP_URL=none
# Netzdaten des Europa-Beispiels (21 MB, Zenodo). "none" lässt sie aus.
# GEOFACT_EUROPA_DATA=none

# --- Sprachmodell (optional, nur für "Szenario generieren") ---------------------
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# GEOFACT_LLM_MODEL=anthropic/claude-3.5-sonnet
