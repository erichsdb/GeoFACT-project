# Variablen, die docker-compose.yml für den Betrieb auf einem eigenen Server
# (Coolify/Hetzner) erwartet.
# Coolify setzt Umgebungsvariablen in seiner Oberfläche (Ressource -> Environment
# Variables), nicht über eine .env-Datei im Repo: diese Datei ist eine Kopiervorlage
# und wird vom Deployment nicht gelesen. Für die lokale Entwicklung gilt .env.example,
# für die lokale Demo braucht es keine Variablen (docker-compose.demo.yml).

# =====================================================================
# 1. Netzzugang zur Datenbank (Tailscale)
# =====================================================================

# Der Backend-Container tritt dem Tailnet bei (docker/backend-entrypoint.sh).
TS_AUTHKEY=tskey-auth-...

# =====================================================================
# 2. Daten
# =====================================================================

# PostGIS mit OSM-Import. Host ist die Tailscale-Adresse oder der MagicDNS-Name
# des Datenbankrechners, nicht seine lokale Adresse.
GEOFACT_PG_DSN=postgresql://<user>:<passwort>@<tailscale-host>:15432/<dbname>
GEOFACT_PG_QUERY_TIMEOUT_S=120

# Verzeichnis auf dem Server mit den großen Rasterdateien (examples/data, rund 8 GB).
# Sie sind nicht im Image enthalten (.dockerignore) und werden einmalig von Hand
# kopiert. Ohne sie bleibt der Rasterkatalog leer; Szenarien ohne Raster laufen.
GEOFACT_COPERNICUS_HOST_DIR=/srv/geofact/copernicus

# =====================================================================
# 3. Anmeldung und Läufe
# =====================================================================

# Nutzer als name:salt.hash, kommagetrennt; erzeugen mit
# uv run python scripts/add_web_user.py <name>
GEOFACT_WEB_USERS=alice:...,bob:...
# Signaturschlüssel, z. B. python -c "import secrets; print(secrets.token_hex(32))"
GEOFACT_WEB_SECRET_KEY=...
# Gültigkeit einer Anmeldung in Sekunden
GEOFACT_WEB_TOKEN_TTL_S=43200
# Gleichzeitige Läufe je Nutzer
GEOFACT_WEB_MAX_CONCURRENT_RUNS_PER_USER=2

# =====================================================================
# 4. Öffentliche Adressen
# =====================================================================

# Domain, unter der das Frontend erreichbar ist (CORS-Origin des Backends)
GEOFACT_PUBLIC_ORIGIN=https://geofact.example-domain.de
# Adresse des Backends aus Sicht des Browsers (Build-Argument NEXT_PUBLIC_API_BASE)
GEOFACT_PUBLIC_API_BASE=https://geofact.example-domain.de/api

# =====================================================================
# 5. Sprachmodell (optional; ohne Schlüssel ist nur "Szenario generieren" aus)
# =====================================================================

OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-...
GEOFACT_LLM_MODEL=anthropic/claude-3.5-sonnet
# Reasoning-Ausgabe mitstreamen (nur bei Modellen, die sie liefern)
GEOFACT_LLM_REASONING=true
# Obergrenze der Antwortlänge in Tokens
GEOFACT_LLM_MAX_TOKENS=8000
